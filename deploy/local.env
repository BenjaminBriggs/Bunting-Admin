# Settings for compose.local.yaml. Development values only: every secret here
# is public. Production settings start from .env.example.

BUNTING_VERSION=local
BUNTING_SITE_ADDRESS=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=local-only-nextauth-secret-0123456789abcdef0123456789abcdef

POSTGRES_PASSWORD=localonlypostgrespassword

SIGNING_KEY_SECRET=local-only-signing-secret-0123456789abcdef0123456789abcdef

S3_BUCKET=bunting-configs
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=admin123
CDN_BASE_URL=http://localhost:9000/bunting-configs

AUTH_MODE=oidc
OIDC_ISSUER=http://auth.localhost:5556/dex
OIDC_CLIENT_ID=bunting-admin
OIDC_CLIENT_SECRET=bunting-dev-secret
OIDC_PROVIDER_NAME=Dev SSO

BACKUP_S3_PROVIDER=Minio
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY_ID=admin
BACKUP_S3_SECRET_ACCESS_KEY=admin123
BACKUP_S3_BUCKET=bunting-backups
BACKUP_S3_PREFIX=local
