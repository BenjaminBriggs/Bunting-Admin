# Bunting Admin deployment settings. Copy to .env next to compose.yaml.
# Every value marked REQUIRED must be set or the stack refuses to start.
# Generate secrets with `openssl rand -hex 32`.

# ----------------------------------------
# Release and domain
# ----------------------------------------
# REQUIRED. The image tag to run. Upgrade by changing this and running
# `docker compose pull && docker compose up -d`.
BUNTING_VERSION=1.0.0
# REQUIRED. The domain Caddy serves and gets a certificate for.
BUNTING_SITE_ADDRESS=admin.example.com
# REQUIRED. Must match BUNTING_SITE_ADDRESS, with the scheme.
NEXTAUTH_URL=https://admin.example.com
# REQUIRED.
NEXTAUTH_SECRET=

# ----------------------------------------
# Database
# ----------------------------------------
# REQUIRED. Use hex (openssl rand -hex 24): it is placed in a connection URL.
POSTGRES_PASSWORD=
# Optional. Set only to use an external Postgres instead of the bundled one.
# DATABASE_URL=postgresql://user:password@host:5432/bunting?sslmode=require

# ----------------------------------------
# Signing-key encryption (REQUIRED: one of the two)
# ----------------------------------------
# Signing keys are stored encrypted in the database. Keep a copy of this
# secret in your password manager: a database backup is useless without it.
SIGNING_KEY_SECRET=
# SIGNING_KEY_KMS_KEY_ID=arn:aws:kms:region:account:key/key-id

# ----------------------------------------
# Published config artifacts (REQUIRED)
# ----------------------------------------
# One bucket for every app; each app publishes under <identifier>/.
S3_BUCKET=bunting-configs
# Cloudflare R2 uses "auto".
S3_REGION=auto
# Omit S3_ENDPOINT for AWS S3.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# The public URL apps fetch from. Use a domain you own: it is compiled into
# every app's BuntingConfig.plist and cannot change after an app ships.
CDN_BASE_URL=https://flags.example.com

# ----------------------------------------
# Sign-in (REQUIRED: at least one provider)
# ----------------------------------------
AUTH_MODE=oidc
# Generic OIDC. Redirect URL to register: <NEXTAUTH_URL>/api/auth/callback/oidc
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=SSO
# GitHub. Callback URL: <NEXTAUTH_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Google. Callback URL: <NEXTAUTH_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The full list (proxy mode, Microsoft) is in the admin repo's .env.example.

# ----------------------------------------
# Off-host backups (REQUIRED)
# ----------------------------------------
# Any S3-compatible bucket. Use a different bucket from S3_BUCKET, and add a
# lifecycle rule to expire old dumps.
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=bunting-backups
BACKUP_S3_PREFIX=bunting
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_KEEP_DAYS=14

# LOG_LEVEL=info
